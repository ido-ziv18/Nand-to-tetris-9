class GraphicsManager {
    static int squareSize;
    static int gridSize;
    static Point gridOrigin;
    
    function void initRenderBoard(Board board) {
        var int size;
        var int leftX;
        var int topY;
        
        let gridSize = 140; //fixed grid dimensions
        let size = board.getSize();
        let squareSize = gridSize / size;
        let topY = 245 - gridSize;
        let leftX = 256 - ((size / 2) * squareSize);
        let gridOrigin = Point.new(leftX, topY);
        do GraphicsManager.initGrid(board);

        return;
    }

    function void initGrid(Board board) {
        var int size;
        var int row;
        var int col;
        
        let size = board.getSize();
        do GraphicsManager.drawVerticalLines(size);
        do GraphicsManager.drawHorizontalLines(size);
        
        let row = 0;
        while (row < size) {
            let col = 0;
            while (col < size) {
                do GraphicsManager.paintSquare(row, col, board.getSquare(row, col));
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }

    function void drawVerticalLines(int size) {
        var int index;
        var int bottomY;
        var int x;
        var int topY;
        
        let topY = gridOrigin.getY();
        let bottomY = topY + (size * squareSize);
        let x = gridOrigin.getX();
        
        let index = 0;
        while (index < (size + 1)) {
            do Screen.drawLine(x, topY, x, bottomY);
            let index = index + 1;
            let x = x + squareSize;
        }
        return;
    }

    function void drawHorizontalLines(int size) {
        var int index;
        var int leftX;
        var int rightX;
        var int y;
        
        let leftX = gridOrigin.getX();
        let rightX = leftX + (size * squareSize);
        let y = gridOrigin.getY();
        
        let index = 0;
        while (index < (size + 1)) {
            do Screen.drawLine(leftX, y, rightX, y);
            let index = index + 1;
            let y = y + squareSize;
        }
        return;
    }
    
    function void paintSquare(int row, int col, boolean color) {
        var int x1;
        var int y1;
        var int x2;
        var int y2;
        
        let x1 = (gridOrigin.getX() + (col * squareSize)) + 1;
        let y1 = (gridOrigin.getY() + (row * squareSize)) + 1;
        let x2 = (x1 + squareSize) - 2;
        let y2 = (y1 + squareSize) - 2;
        do Screen.setColor(color);
        do Screen.drawRectangle(x1, y1, x2, y2);
        return;
    }

    function void drawCursor(int row, int col, boolean squareColor) {
        var int cx;
        var int cy;
        var int radius;
        
        // calculate center of the square
        let cx = (gridOrigin.getX() + (col * squareSize)) + (squareSize / 2);
        let cy = (gridOrigin.getY() + (row * squareSize)) + (squareSize / 2);
        // radius is about 1/4 of square size
        let radius = squareSize / 4;
        // draw circle in opposite color
        do Screen.setColor(~squareColor);
        do Screen.drawCircle(cx, cy, radius);
        return;
    }
}