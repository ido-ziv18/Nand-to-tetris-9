class GraphicsManager {
    static int squareSize;
    static int gridSize;
    static Point gridOrigin;
    
    function void initRenderBoard(Board board) {
        var int size;
        var int leftX;
        var int topY;
        
        let gridSize = 140; //fixed grid dimensions
        let size = board.getSize();
        let squareSize = gridSize / size;
        let topY = 245 - gridSize;
        let leftX = 256 - ((size / 2) * squareSize);
        let gridOrigin = Point.new(leftX, topY);
        do GraphicsManager.initGrid(board);

        return;
    }

    function void initGrid(Board board) {
        var int size;
        var int row;
        var int col;
        var int state;
        
        let size = board.getSize();
        do GraphicsManager.drawVerticalLines(size);
        do GraphicsManager.drawHorizontalLines(size);
        
        let row = 0;
        while (row < size) {
            let col = 0;
            while (col < size) {
                let state = board.getSquare(row, col);
                // 0=white, 1=black, 2=flagged (paint white + X)
                if (state = 1) {
                    do GraphicsManager.paintSquare(row, col, true);
                } else {
                    do GraphicsManager.paintSquare(row, col, false);
                    if (state = 2) {
                        do GraphicsManager.drawFlag(row, col);
                    }
                }
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }

    function void drawVerticalLines(int size) {
        var int index;
        var int bottomY;
        var int x;
        var int topY;
        
        do Screen.setColor(true);  // black lines
        let topY = gridOrigin.getY();
        let bottomY = topY + (size * squareSize);
        let x = gridOrigin.getX();
        
        let index = 0;
        while (index < (size + 1)) {
            do Screen.drawLine(x, topY, x, bottomY);
            let index = index + 1;
            let x = x + squareSize;
        }
        return;
    }

    function void drawHorizontalLines(int size) {
        var int index;
        var int leftX;
        var int rightX;
        var int y;
        
        do Screen.setColor(true);  // black lines
        let leftX = gridOrigin.getX();
        let rightX = leftX + (size * squareSize);
        let y = gridOrigin.getY();
        
        let index = 0;
        while (index < (size + 1)) {
            do Screen.drawLine(leftX, y, rightX, y);
            let index = index + 1;
            let y = y + squareSize;
        }
        return;
    }
    
    function void paintSquare(int row, int col, boolean color) {
        var int x1;
        var int y1;
        var int x2;
        var int y2;
        
        let x1 = (gridOrigin.getX() + (col * squareSize)) + 1;
        let y1 = (gridOrigin.getY() + (row * squareSize)) + 1;
        let x2 = (x1 + squareSize) - 2;
        let y2 = (y1 + squareSize) - 2;
        do Screen.setColor(color);
        do Screen.drawRectangle(x1, y1, x2, y2);
        return;
    }

    function void drawCursor(int row, int col, boolean squareColor) {
        var int cx;
        var int cy;
        var int radius;
        
        // calculate center of the square
        let cx = (gridOrigin.getX() + (col * squareSize)) + (squareSize / 2);
        let cy = (gridOrigin.getY() + (row * squareSize)) + (squareSize / 2);
        // radius is about 1/4 of square size
        let radius = squareSize / 4;
        // draw circle in opposite color
        do Screen.setColor(~squareColor);
        do Screen.drawCircle(cx, cy, radius);
        return;
    }
    
    /** Draws an X flag on a square (square should already be white) */
    function void drawFlag(int row, int col) {
        var int x1;
        var int y1;
        var int x2;
        var int y2;
        var int margin;
        
        // calculate square bounds with margin
        let margin = 3;
        let x1 = (gridOrigin.getX() + (col * squareSize)) + margin;
        let y1 = (gridOrigin.getY() + (row * squareSize)) + margin;
        let x2 = (x1 + squareSize) - (margin * 2);
        let y2 = (y1 + squareSize) - (margin * 2);
        
        // draw X in black
        do Screen.setColor(true);
        // diagonal from top-left to bottom-right
        do Screen.drawLine(x1, y1, x2, y2);
        // diagonal from top-right to bottom-left
        do Screen.drawLine(x2, y1, x1, y2);
        return;
    }
    
    /** Renders row constraints to the left of the grid */
    function void renderRowConstraints(Array constraints, int boardSize) {
        var int row;
        var int y;
        var int x;
        var Array rowConstraint;
        var int len;
        var int i;
        var int value;
        var int totalWidth;
        
        let row = 0;
        while (row < boardSize) {
            let rowConstraint = constraints[row];
            let len = rowConstraint[0];  // length stored at index 0
            
            // Calculate y position: vertically centered in row
            let y = (gridOrigin.getY() + (row * squareSize)) + ((squareSize - 10) / 2);
            
            // Calculate total width of all constraint numbers
            let totalWidth = 0;
            let i = 0;
            while (i < len) {
                let value = rowConstraint[i + 1];  // values start at index 1
                let totalWidth = totalWidth + DigitRenderer.getNumberWidth(value);
                if (i < (len - 1)) {
                    let totalWidth = totalWidth + 5;  // gap between numbers
                }
                let i = i + 1;
            }
            
            // Start x position: right-aligned to left of grid with 4px gap
            let x = (gridOrigin.getX() - totalWidth) - 4;
            
            // Draw each constraint number
            let i = 0;
            while (i < len) {
                let value = rowConstraint[i + 1];
                do DigitRenderer.drawNumber(x, y, value);
                let x = x + DigitRenderer.getNumberWidth(value) + 5;
                let i = i + 1;
            }
            
            let row = row + 1;
        }
        return;
    }
    
    /** Renders column constraints above the grid */
    function void renderColConstraints(Array constraints, int boardSize) {
        var int col;
        var int x;
        var int y;
        var Array colConstraint;
        var int len;
        var int i;
        var int value;
        var int numWidth;
        
        let col = 0;
        while (col < boardSize) {
            let colConstraint = constraints[col];
            let len = colConstraint[0];  // length stored at index 0
            
            // Start y from bottom (closest to grid) and go up
            // Bottom y position: just above the grid with 4px gap
            let y = (gridOrigin.getY() - 10) - 4;  // 10 = digit height
            
            // Draw from bottom to top (last constraint closest to grid)
            let i = len - 1;
            while (i > -1) {
                let value = colConstraint[i + 1];  // values start at index 1
                let numWidth = DigitRenderer.getNumberWidth(value);
                
                // Center x in the column
                let x = (gridOrigin.getX() + (col * squareSize)) + ((squareSize - numWidth) / 2);
                
                do DigitRenderer.drawNumber(x, y, value);
                
                let y = y - 14;  // move up for next number (10 height + 4 gap)
                let i = i - 1;
            }
            
            let col = col + 1;
        }
        return;
    }
    
    /** Renders all constraints (both row and column) */
    function void renderAllConstraints(Array rowConstraints, Array colConstraints, int boardSize) {
        do GraphicsManager.renderRowConstraints(rowConstraints, boardSize);
        do GraphicsManager.renderColConstraints(colConstraints, boardSize);
        return;
    }
}