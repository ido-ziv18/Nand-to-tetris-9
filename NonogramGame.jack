class NonogramGame {
    static Board solution;
    static Board board;
    static int cursorRow;
    static int cursorCol;
    static int boardSize;
    static int mismatchCount;
    static Array rowConstraints;
    static Array colConstraints;
    static int currentPuzzle;  // 0-3, cycles through puzzles
    function void initGame() {
        // create solution and get initial mismatch count
        let mismatchCount = NonogramGame.createSolution();
        let boardSize = solution.getSize();
        
        // generate constraints from solution (once, stays fixed until win)
        let rowConstraints = Board.getRowConstraints(solution);
        let colConstraints = Board.getColConstraints(solution);
        
        // create empty player board
        let board = Board.new(boardSize);
        
        // render the empty board (not solution)
        do GraphicsManager.initRenderBoard(board);
        
        // render the constraints
        do GraphicsManager.renderAllConstraints(rowConstraints, colConstraints, boardSize);
        
        // initialize cursor at top-left
        let cursorRow = 0;
        let cursorCol = 0;
        do GraphicsManager.drawCursor(cursorRow, cursorCol, board.getSquare(cursorRow, cursorCol) = 1);
        return;
    }
    
    /** Creates the solution board and returns the number of black squares */
    function int createSolution() {
        var int blackCount;
        
        if (currentPuzzle = 0) { let blackCount = NonogramGame.createHeart(); }
        if (currentPuzzle = 1) { let blackCount = NonogramGame.createSmiley(); }
        if (currentPuzzle = 2) { let blackCount = NonogramGame.createCat(); }
        if (currentPuzzle = 3) { let blackCount = NonogramGame.createSpaceship(); }
        
        return blackCount;
    }
    
    /** Heart shape */
    function int createHeart() {
        var int c;
        let solution = Board.new(10);
        let c = 0;
        // Row 0: ..XX..XX..
        do solution.setSquare(0, 2, 1); let c = c + 1;
        do solution.setSquare(0, 3, 1); let c = c + 1;
        do solution.setSquare(0, 6, 1); let c = c + 1;
        do solution.setSquare(0, 7, 1); let c = c + 1;
        // Row 1: .XXXXXXXXX.
        do solution.setSquare(1, 1, 1); let c = c + 1;
        do solution.setSquare(1, 2, 1); let c = c + 1;
        do solution.setSquare(1, 3, 1); let c = c + 1;
        do solution.setSquare(1, 4, 1); let c = c + 1;
        do solution.setSquare(1, 5, 1); let c = c + 1;
        do solution.setSquare(1, 6, 1); let c = c + 1;
        do solution.setSquare(1, 7, 1); let c = c + 1;
        do solution.setSquare(1, 8, 1); let c = c + 1;
        // Row 2: XXXXXXXXXX
        do solution.setSquare(2, 0, 1); let c = c + 1;
        do solution.setSquare(2, 1, 1); let c = c + 1;
        do solution.setSquare(2, 2, 1); let c = c + 1;
        do solution.setSquare(2, 3, 1); let c = c + 1;
        do solution.setSquare(2, 4, 1); let c = c + 1;
        do solution.setSquare(2, 5, 1); let c = c + 1;
        do solution.setSquare(2, 6, 1); let c = c + 1;
        do solution.setSquare(2, 7, 1); let c = c + 1;
        do solution.setSquare(2, 8, 1); let c = c + 1;
        do solution.setSquare(2, 9, 1); let c = c + 1;
        // Row 3: XXXXXXXXXX
        do solution.setSquare(3, 0, 1); let c = c + 1;
        do solution.setSquare(3, 1, 1); let c = c + 1;
        do solution.setSquare(3, 2, 1); let c = c + 1;
        do solution.setSquare(3, 3, 1); let c = c + 1;
        do solution.setSquare(3, 4, 1); let c = c + 1;
        do solution.setSquare(3, 5, 1); let c = c + 1;
        do solution.setSquare(3, 6, 1); let c = c + 1;
        do solution.setSquare(3, 7, 1); let c = c + 1;
        do solution.setSquare(3, 8, 1); let c = c + 1;
        do solution.setSquare(3, 9, 1); let c = c + 1;
        // Row 4: .XXXXXXXX.
        do solution.setSquare(4, 1, 1); let c = c + 1;
        do solution.setSquare(4, 2, 1); let c = c + 1;
        do solution.setSquare(4, 3, 1); let c = c + 1;
        do solution.setSquare(4, 4, 1); let c = c + 1;
        do solution.setSquare(4, 5, 1); let c = c + 1;
        do solution.setSquare(4, 6, 1); let c = c + 1;
        do solution.setSquare(4, 7, 1); let c = c + 1;
        do solution.setSquare(4, 8, 1); let c = c + 1;
        // Row 5: ..XXXXXX..
        do solution.setSquare(5, 2, 1); let c = c + 1;
        do solution.setSquare(5, 3, 1); let c = c + 1;
        do solution.setSquare(5, 4, 1); let c = c + 1;
        do solution.setSquare(5, 5, 1); let c = c + 1;
        do solution.setSquare(5, 6, 1); let c = c + 1;
        do solution.setSquare(5, 7, 1); let c = c + 1;
        // Row 6: ...XXXX...
        do solution.setSquare(6, 3, 1); let c = c + 1;
        do solution.setSquare(6, 4, 1); let c = c + 1;
        do solution.setSquare(6, 5, 1); let c = c + 1;
        do solution.setSquare(6, 6, 1); let c = c + 1;
        // Row 7: ....XX....
        do solution.setSquare(7, 4, 1); let c = c + 1;
        do solution.setSquare(7, 5, 1); let c = c + 1;
        // Rows 8-9 empty
        return c;
    }
    
    /** Smiley face */
    function int createSmiley() {
        var int c;
        let solution = Board.new(10);
        let c = 0;
        // Row 0: ..XXXXXX..
        do solution.setSquare(0, 2, 1); let c = c + 1;
        do solution.setSquare(0, 3, 1); let c = c + 1;
        do solution.setSquare(0, 4, 1); let c = c + 1;
        do solution.setSquare(0, 5, 1); let c = c + 1;
        do solution.setSquare(0, 6, 1); let c = c + 1;
        do solution.setSquare(0, 7, 1); let c = c + 1;
        // Row 1: .X......X.
        do solution.setSquare(1, 1, 1); let c = c + 1;
        do solution.setSquare(1, 8, 1); let c = c + 1;
        // Row 2: X..XX..XX.X (eyes)
        do solution.setSquare(2, 0, 1); let c = c + 1;
        do solution.setSquare(2, 3, 1); let c = c + 1;
        do solution.setSquare(2, 6, 1); let c = c + 1;
        do solution.setSquare(2, 9, 1); let c = c + 1;
        // Row 3: X........X
        do solution.setSquare(3, 0, 1); let c = c + 1;
        do solution.setSquare(3, 9, 1); let c = c + 1;
        // Row 4: X........X
        do solution.setSquare(4, 0, 1); let c = c + 1;
        do solution.setSquare(4, 9, 1); let c = c + 1;
        // Row 5: X.X....X.X (smile corners)
        do solution.setSquare(5, 0, 1); let c = c + 1;
        do solution.setSquare(5, 2, 1); let c = c + 1;
        do solution.setSquare(5, 7, 1); let c = c + 1;
        do solution.setSquare(5, 9, 1); let c = c + 1;
        // Row 6: X..XXXX..X (smile)
        do solution.setSquare(6, 0, 1); let c = c + 1;
        do solution.setSquare(6, 3, 1); let c = c + 1;
        do solution.setSquare(6, 4, 1); let c = c + 1;
        do solution.setSquare(6, 5, 1); let c = c + 1;
        do solution.setSquare(6, 6, 1); let c = c + 1;
        do solution.setSquare(6, 9, 1); let c = c + 1;
        // Row 7: .X......X.
        do solution.setSquare(7, 1, 1); let c = c + 1;
        do solution.setSquare(7, 8, 1); let c = c + 1;
        // Row 8: ..XXXXXX..
        do solution.setSquare(8, 2, 1); let c = c + 1;
        do solution.setSquare(8, 3, 1); let c = c + 1;
        do solution.setSquare(8, 4, 1); let c = c + 1;
        do solution.setSquare(8, 5, 1); let c = c + 1;
        do solution.setSquare(8, 6, 1); let c = c + 1;
        do solution.setSquare(8, 7, 1); let c = c + 1;
        // Row 9: empty
        return c;
    }
    
    /** Cat face */
    function int createCat() {
        var int c;
        let solution = Board.new(10);
        let c = 0;
        // Row 0: X........X (ears)
        do solution.setSquare(0, 0, 1); let c = c + 1;
        do solution.setSquare(0, 9, 1); let c = c + 1;
        // Row 1: XX......XX
        do solution.setSquare(1, 0, 1); let c = c + 1;
        do solution.setSquare(1, 1, 1); let c = c + 1;
        do solution.setSquare(1, 8, 1); let c = c + 1;
        do solution.setSquare(1, 9, 1); let c = c + 1;
        // Row 2: XXX....XXX
        do solution.setSquare(2, 0, 1); let c = c + 1;
        do solution.setSquare(2, 1, 1); let c = c + 1;
        do solution.setSquare(2, 2, 1); let c = c + 1;
        do solution.setSquare(2, 7, 1); let c = c + 1;
        do solution.setSquare(2, 8, 1); let c = c + 1;
        do solution.setSquare(2, 9, 1); let c = c + 1;
        // Row 3: .XXXXXXXX.
        do solution.setSquare(3, 1, 1); let c = c + 1;
        do solution.setSquare(3, 2, 1); let c = c + 1;
        do solution.setSquare(3, 3, 1); let c = c + 1;
        do solution.setSquare(3, 4, 1); let c = c + 1;
        do solution.setSquare(3, 5, 1); let c = c + 1;
        do solution.setSquare(3, 6, 1); let c = c + 1;
        do solution.setSquare(3, 7, 1); let c = c + 1;
        do solution.setSquare(3, 8, 1); let c = c + 1;
        // Row 4: .X.XX.XX.X (eyes)
        do solution.setSquare(4, 1, 1); let c = c + 1;
        do solution.setSquare(4, 3, 1); let c = c + 1;
        do solution.setSquare(4, 4, 1); let c = c + 1;
        do solution.setSquare(4, 6, 1); let c = c + 1;
        do solution.setSquare(4, 7, 1); let c = c + 1;
        do solution.setSquare(4, 8, 1); let c = c + 1;
        // Row 5: .XXXXXXXX.
        do solution.setSquare(5, 1, 1); let c = c + 1;
        do solution.setSquare(5, 2, 1); let c = c + 1;
        do solution.setSquare(5, 3, 1); let c = c + 1;
        do solution.setSquare(5, 4, 1); let c = c + 1;
        do solution.setSquare(5, 5, 1); let c = c + 1;
        do solution.setSquare(5, 6, 1); let c = c + 1;
        do solution.setSquare(5, 7, 1); let c = c + 1;
        do solution.setSquare(5, 8, 1); let c = c + 1;
        // Row 6: .X..XX..X. (nose)
        do solution.setSquare(6, 1, 1); let c = c + 1;
        do solution.setSquare(6, 4, 1); let c = c + 1;
        do solution.setSquare(6, 5, 1); let c = c + 1;
        do solution.setSquare(6, 8, 1); let c = c + 1;
        // Row 7: .X.X..X.X. (whiskers)
        do solution.setSquare(7, 1, 1); let c = c + 1;
        do solution.setSquare(7, 3, 1); let c = c + 1;
        do solution.setSquare(7, 6, 1); let c = c + 1;
        do solution.setSquare(7, 8, 1); let c = c + 1;
        // Row 8: ..XXXXXX..
        do solution.setSquare(8, 2, 1); let c = c + 1;
        do solution.setSquare(8, 3, 1); let c = c + 1;
        do solution.setSquare(8, 4, 1); let c = c + 1;
        do solution.setSquare(8, 5, 1); let c = c + 1;
        do solution.setSquare(8, 6, 1); let c = c + 1;
        do solution.setSquare(8, 7, 1); let c = c + 1;
        // Row 9: empty
        return c;
    }
    
    /** Spaceship/Rocket */
    function int createSpaceship() {
        var int c;
        let solution = Board.new(10);
        let c = 0;
        // Row 0: ....XX....
        do solution.setSquare(0, 4, 1); let c = c + 1;
        do solution.setSquare(0, 5, 1); let c = c + 1;
        // Row 1: ...XXXX...
        do solution.setSquare(1, 3, 1); let c = c + 1;
        do solution.setSquare(1, 4, 1); let c = c + 1;
        do solution.setSquare(1, 5, 1); let c = c + 1;
        do solution.setSquare(1, 6, 1); let c = c + 1;
        // Row 2: ...XXXX...
        do solution.setSquare(2, 3, 1); let c = c + 1;
        do solution.setSquare(2, 4, 1); let c = c + 1;
        do solution.setSquare(2, 5, 1); let c = c + 1;
        do solution.setSquare(2, 6, 1); let c = c + 1;
        // Row 3: ..XXXXXX..
        do solution.setSquare(3, 2, 1); let c = c + 1;
        do solution.setSquare(3, 3, 1); let c = c + 1;
        do solution.setSquare(3, 4, 1); let c = c + 1;
        do solution.setSquare(3, 5, 1); let c = c + 1;
        do solution.setSquare(3, 6, 1); let c = c + 1;
        do solution.setSquare(3, 7, 1); let c = c + 1;
        // Row 4: ..XXXXXX..
        do solution.setSquare(4, 2, 1); let c = c + 1;
        do solution.setSquare(4, 3, 1); let c = c + 1;
        do solution.setSquare(4, 4, 1); let c = c + 1;
        do solution.setSquare(4, 5, 1); let c = c + 1;
        do solution.setSquare(4, 6, 1); let c = c + 1;
        do solution.setSquare(4, 7, 1); let c = c + 1;
        // Row 5: .XXXXXXXX.
        do solution.setSquare(5, 1, 1); let c = c + 1;
        do solution.setSquare(5, 2, 1); let c = c + 1;
        do solution.setSquare(5, 3, 1); let c = c + 1;
        do solution.setSquare(5, 4, 1); let c = c + 1;
        do solution.setSquare(5, 5, 1); let c = c + 1;
        do solution.setSquare(5, 6, 1); let c = c + 1;
        do solution.setSquare(5, 7, 1); let c = c + 1;
        do solution.setSquare(5, 8, 1); let c = c + 1;
        // Row 6: .XX.XX.XX. (windows)
        do solution.setSquare(6, 1, 1); let c = c + 1;
        do solution.setSquare(6, 2, 1); let c = c + 1;
        do solution.setSquare(6, 4, 1); let c = c + 1;
        do solution.setSquare(6, 5, 1); let c = c + 1;
        do solution.setSquare(6, 7, 1); let c = c + 1;
        do solution.setSquare(6, 8, 1); let c = c + 1;
        // Row 7: XX..XX..XX (fins)
        do solution.setSquare(7, 0, 1); let c = c + 1;
        do solution.setSquare(7, 1, 1); let c = c + 1;
        do solution.setSquare(7, 4, 1); let c = c + 1;
        do solution.setSquare(7, 5, 1); let c = c + 1;
        do solution.setSquare(7, 8, 1); let c = c + 1;
        do solution.setSquare(7, 9, 1); let c = c + 1;
        // Row 8: ....XX.... (flame)
        do solution.setSquare(8, 4, 1); let c = c + 1;
        do solution.setSquare(8, 5, 1); let c = c + 1;
        // Row 9: ...X..X... (flame)
        do solution.setSquare(9, 3, 1); let c = c + 1;
        do solution.setSquare(9, 6, 1); let c = c + 1;
        return c;
    }

    function void run() {
        var int key;
        var int prevKey;
        var boolean running;
        
        do NonogramGame.initGame();
        let prevKey = 0;
        let running = true;
        
        while (running) {
            let key = Keyboard.keyPressed();
            
            // only act on new key press (not held)
            if (~(key = prevKey)) {
                if (key = 140) { let running = false; }                // ESC - quit
                if (key = 130) { do NonogramGame.moveCursor(0, -1); }  // left
                if (key = 131) { do NonogramGame.moveCursor(-1, 0); }  // up
                if (key = 132) { do NonogramGame.moveCursor(0, 1); }   // right
                if (key = 133) { do NonogramGame.moveCursor(1, 0); }   // down
                if (key = 32)  { do NonogramGame.toggleSquare(); }     // space
                if (key = 88)  { do NonogramGame.toggleFlag(); }       // X key
                if (key = 120) { do NonogramGame.toggleFlag(); }       // x key (lowercase)
            }
            let prevKey = key;
        }
        
        // cleanup before exiting
        do NonogramGame.dispose();
        return;
    }
    
    function void moveCursor(int dRow, int dCol) {
        var int newRow;
        var int newCol;
        var int oldState;
        
        let newRow = cursorRow + dRow;
        let newCol = cursorCol + dCol;
        
        // bounds checking
        if ((newRow > -1) & (newRow < boardSize)) {
            if ((newCol > -1) & (newCol < boardSize)) {
                let oldState = board.getSquare(cursorRow, cursorCol);
                // erase old cursor by repainting the square
                do NonogramGame.repaintSquare(cursorRow, cursorCol);
                // update position
                let cursorRow = newRow;
                let cursorCol = newCol;
                // draw new cursor (pass 1 if black, 0 otherwise for cursor color)
                do GraphicsManager.drawCursor(cursorRow, cursorCol, board.getSquare(cursorRow, cursorCol) = 1);
            }
        }
        return;
    }
    
    /** Helper to repaint a square based on its state */
    function void repaintSquare(int row, int col) {
        var int state;
        let state = board.getSquare(row, col);
        if (state = 1) {
            // black
            do GraphicsManager.paintSquare(row, col, true);
        } else {
            // white or flagged - paint white first
            do GraphicsManager.paintSquare(row, col, false);
            if (state = 2) {
                // flagged - draw X
                do GraphicsManager.drawFlag(row, col);
            }
        }
        return;
    }
    
    /** Toggle between white (0) and black (1). Clears flag if present. */
    function void toggleSquare() {
        var int oldState;
        var int newState;
        var int solutionState;
        var int oldEffective;
        var int newEffective;
        
        let oldState = board.getSquare(cursorRow, cursorCol);
        let solutionState = solution.getSquare(cursorRow, cursorCol);
        
        // Determine new state: toggle between 0 and 1 (flagged becomes black)
        if (oldState = 1) {
            let newState = 0;  // black -> white
        } else {
            let newState = 1;  // white or flagged -> black
        }
        
        // For mismatch: old state 0 or 2 counts as "not black" (0), state 1 counts as black (1)
        if (oldState = 1) {
            let oldEffective = 1;
        } else {
            let oldEffective = 0;
        }
        let newEffective = newState;
        
        // update mismatch count
        if (oldEffective = solutionState) {
            let mismatchCount = mismatchCount + 1;  // was matching, now won't
        }
        if (newEffective = solutionState) {
            let mismatchCount = mismatchCount - 1;  // now matches
        }
        
        // update the board
        do board.setSquare(cursorRow, cursorCol, newState);
        // repaint the square
        do GraphicsManager.paintSquare(cursorRow, cursorCol, newState = 1);
        // redraw cursor
        do GraphicsManager.drawCursor(cursorRow, cursorCol, newState = 1);
        
        // check win condition
        if (mismatchCount = 0) {
            do NonogramGame.handleWin();
        }
        return;
    }
    
    /** Toggle flag (X mark) on current square. State 2 = flagged. */
    function void toggleFlag() {
        var int state;
        var int solutionState;
        
        let state = board.getSquare(cursorRow, cursorCol);
        let solutionState = solution.getSquare(cursorRow, cursorCol);
        
        if (state = 2) {
            // Already flagged: remove flag -> white (0)
            do board.setSquare(cursorRow, cursorCol, 0);
            do GraphicsManager.paintSquare(cursorRow, cursorCol, false);
        } else {
            if (state = 1) {
                // Black: turn flagged, update mismatch
                if (solutionState = 1) {
                    let mismatchCount = mismatchCount + 1;  // was matching black, now won't
                } else {
                    let mismatchCount = mismatchCount - 1;  // wasn't matching, now matches white
                }
            }
            // Set to flagged (2)
            do board.setSquare(cursorRow, cursorCol, 2);
            do GraphicsManager.paintSquare(cursorRow, cursorCol, false);
            do GraphicsManager.drawFlag(cursorRow, cursorCol);
        }
        
        // redraw cursor (flagged squares are visually white)
        do GraphicsManager.drawCursor(cursorRow, cursorCol, false);
        
        // check win condition
        if (mismatchCount = 0) {
            do NonogramGame.handleWin();
        }
        return;
    }
    
    function void handleWin() {
        // clear any previous message and display success
        do Output.moveCursor(0, 0);
        do Output.printString("        ");  // clear old text
        do Output.moveCursor(0, 0);
        do Output.printString("Success!");
        
        // wait so user can see the message
        do Sys.wait(1000);
        
        // clear the message
        do Output.moveCursor(0, 0);
        do Output.printString("        ");
        
        // move to next puzzle (cycle 0-3)
        let currentPuzzle = currentPuzzle + 1;
        if (currentPuzzle > 3) {
            let currentPuzzle = 0;
        }
        
        // clear screen for new puzzle
        do Screen.clearScreen();
        
        // create new solution
        let mismatchCount = NonogramGame.createSolution();
        
        // generate new constraints
        let rowConstraints = Board.getRowConstraints(solution);
        let colConstraints = Board.getColConstraints(solution);
        
        // clear and reset player board
        do board.clear();
        
        // re-render the empty board
        do GraphicsManager.initGrid(board);
        
        // render new constraints
        do GraphicsManager.renderAllConstraints(rowConstraints, colConstraints, boardSize);
        
        // reset cursor to top-left
        let cursorRow = 0;
        let cursorCol = 0;
        do GraphicsManager.drawCursor(cursorRow, cursorCol, board.getSquare(cursorRow, cursorCol) = 1);
        return;
    }
    
    /** Disposes all game objects */
    function void dispose() {
        // dispose boards
        do board.dispose();
        do solution.dispose();
        
        // dispose constraint arrays
        do NonogramGame.disposeConstraints(rowConstraints, boardSize);
        do NonogramGame.disposeConstraints(colConstraints, boardSize);
        
        // dispose graphics manager resources
        do GraphicsManager.dispose();
        
        // clear screen
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        do Output.printString("Goodbye!");
        return;
    }
    
    /** Helper to dispose constraint arrays */
    function void disposeConstraints(Array constraints, int size) {
        var int i;
        var Array constraint;
        
        let i = 0;
        while (i < size) {
            let constraint = constraints[i];
            do Memory.deAlloc(constraint);
            let i = i + 1;
        }
        do Memory.deAlloc(constraints);
        return;
    }
}