class NonogramGame {
    static Board solution;
    static Board board;
    static int cursorRow;
    static int cursorCol;
    static int boardSize;
    function void initGame() {
        // draw something to solution
        let solution = Board.new(10);
        do solution.setSquare(0, 0, true);
        do solution.setSquare(0, 1, true);
        do solution.setSquare(0, 2, true);
        do solution.setSquare(0, 3, true);
        do solution.setSquare(0, 4, true);
        do solution.setSquare(0, 5, true);
        do solution.setSquare(0, 6, true);
        do solution.setSquare(0, 7, true);
        do solution.setSquare(0, 8, true);
        do solution.setSquare(0, 9, true);
        do GraphicsManager.initRenderBoard(solution);
        // initialize cursor at top-left
        let cursorRow = 0;
        let cursorCol = 0;
        let boardSize = solution.getSize();
        do GraphicsManager.drawCursor(cursorRow, cursorCol, solution.getSquare(cursorRow, cursorCol));
        // write constraints
        return;
    }

    function void run() {
        var int key;
        var int prevKey;
        
        do NonogramGame.initGame();
        let prevKey = 0;
        
        while (true) {
            let key = Keyboard.keyPressed();
            
            // only act on new key press (not held)
            if (~(key = prevKey)) {
                if (key = 130) { do NonogramGame.moveCursor(0, -1); }  // left
                if (key = 131) { do NonogramGame.moveCursor(-1, 0); }  // up
                if (key = 132) { do NonogramGame.moveCursor(0, 1); }   // right
                if (key = 133) { do NonogramGame.moveCursor(1, 0); }   // down
                if (key = 32)  { do NonogramGame.toggleSquare(); }     // space
            }
            let prevKey = key;
        }
        return;
    }
    
    function void moveCursor(int dRow, int dCol) {
        var int newRow;
        var int newCol;
        
        let newRow = cursorRow + dRow;
        let newCol = cursorCol + dCol;
        
        // bounds checking
        if ((newRow > -1) & (newRow < boardSize)) {
            if ((newCol > -1) & (newCol < boardSize)) {
                // erase old cursor by repainting the square
                do GraphicsManager.paintSquare(cursorRow, cursorCol, solution.getSquare(cursorRow, cursorCol));
                // update position
                let cursorRow = newRow;
                let cursorCol = newCol;
                // draw new cursor
                do GraphicsManager.drawCursor(cursorRow, cursorCol, solution.getSquare(cursorRow, cursorCol));
            }
        }
        return;
    }
    
    function void toggleSquare() {
        var boolean currentColor;
        var boolean newColor;
        
        let currentColor = solution.getSquare(cursorRow, cursorCol);
        let newColor = ~currentColor;
        
        // update the board
        do solution.setSquare(cursorRow, cursorCol, newColor);
        // repaint the square with new color
        do GraphicsManager.paintSquare(cursorRow, cursorCol, newColor);
        // redraw cursor with opposite of new color
        do GraphicsManager.drawCursor(cursorRow, cursorCol, newColor);
        return;
    }
}