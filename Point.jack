class Point {
    field int x;
    field int y;
    
    constructor Point new(int ax, int ay) {
        let x = ax;
        let y = ay;
        return this;
    }

    method int getX() {
        return x;
    }

    method int getY() {
        return y;
    }

    method void setX(int ax) {
        let x = ax;
        return;
    }

    method void setY(int ay) {
        let y = ay;
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}

