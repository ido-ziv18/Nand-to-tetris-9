class Board {
    field Array board;
    field int size;
    
    constructor Board new(int asize) {
        let size = asize;
        let board = Array.new(size);
        do createBoard();
        return this;
    }

    method void createBoard() {
        var int rowIndex;
        var int colIndex;
        var Array row;
        let rowIndex = 0;
        while (rowIndex < size) {
            let row = Array.new(size);
            let colIndex = 0;
            while (colIndex < size) {
                let row[colIndex] = false;
                let colIndex = colIndex + 1;
            }
            let board[rowIndex] = row;
            let rowIndex = rowIndex + 1; 
        }
        return;
    }

    method void validateSquare(int row, int col) {
        if (((row < 0) | (row > (size - 1))) | ((col < 0) | (col > (size - 1)))) {
            do Sys.error(21);
        }
        return;
    }

    method void setSquare(int row, int col, boolean color) {
        var Array rowArray;
        do validateSquare(row, col);
        let rowArray = board[row];
        let rowArray[col] = color;
        return;
    }

    method int getSize() {
        var int temp;
        let temp = size;
        return size;
    }

    method boolean getSquare(int row, int col) {
        var Array rowArray;
        do validateSquare(row, col);
        let rowArray = board[row];
        return rowArray[col];
    }

    /** clears the board. sets all squares to false */
    method void clear() {
        var int rowIndex;
        var int colIndex;
        let rowIndex = 0;
        while (rowIndex < size) {
            let colIndex = 0;
            while (colIndex < size) {
                do setSquare(rowIndex, colIndex, false);
                let colIndex = colIndex + 1;
            }
            let rowIndex = rowIndex + 1;
        }
        return;

    }

    method void dispose() {
        var int rowIndex;
        var Array row;
        
        let rowIndex = 0;
        while (rowIndex < size) {
            let row = board[rowIndex];
            do Memory.deAlloc(row);
            let rowIndex = rowIndex + 1;
        }
        
        do Memory.deAlloc(this);
        return;
    }
}